# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use SQLite (db.sqlite3). Set for PostgreSQL:
# DATABASE_URL=postgres://user:pass@localhost:5432/truckrouting

# Comma-separated origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upstream services (all free, no key required)
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# Nominatim's usage policy requires a contact in the User-Agent
GEOCODER_USER_AGENT=weather-aware-truck-routing/1.0
UPSTREAM_TIMEOUT_SECONDS=20

# Production hardening (leave unset in development)
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
