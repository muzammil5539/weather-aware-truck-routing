# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use SQLite (db.sqlite3). Set for PostgreSQL:
# DATABASE_URL=postgres://user:pass@localhost:5432/truckrouting

# Comma-separated origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upstream services (all free, no key required).
# Each has a backup that is used only when the primary rate-limits, times out
# or faults. A "no such place" or "no route" answer does not trigger a fallback.

# Routing: comma-separated, tried in order. Both speak the OSRM protocol.
OSRM_BASE_URLS=https://router.project-osrm.org,https://routing.openstreetmap.de/routed-car

# Geocoding: Nominatim first, Photon as the backup.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
PHOTON_BASE_URL=https://photon.komoot.io

# Weather: Open-Meteo first, MET Norway as the backup.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
MET_NO_BASE_URL=https://api.met.no/weatherapi/locationforecast/2.0/compact
# MET Norway serves one coordinate per request; keep concurrency modest.
MET_NO_MAX_CONCURRENCY=5

# Forecasts are cached in-process by default. Set this to share across workers.
# REDIS_URL=redis://localhost:6379/0
# Nominatim's usage policy requires a contact in the User-Agent
GEOCODER_USER_AGENT=weather-aware-truck-routing/1.0
UPSTREAM_TIMEOUT_SECONDS=20

# Production hardening (leave unset in development)
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
